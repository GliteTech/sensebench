{% extends "base.html.j2" %}

{% block content %}
{% set entry = detail.entry %}
{% set metadata = detail.metadata %}
<section class="run-head">
  <div>
    <p class="eyebrow">Verified run</p>
    <h1>{{ entry.model }}</h1>
    <p class="run-id">{{ entry.run_id }}</p>
  </div>
  <dl class="summary-grid">
    <div>
      <dt>Rank</dt>
      <dd>{{ entry.rank }}</dd>
    </div>
    <div>
      <dt>Accuracy <span class="dt-sub">lexEN v1 · WordNet fine</span></dt>
      <dd>{{ entry.accuracy|pct }}</dd>
    </div>
    <div>
      <dt>Correct</dt>
      <dd>{{ entry.correct_count }} / {{ entry.item_count }}</dd>
    </div>
    <div>
      <dt>Actual run cost</dt>
      <dd>{{ entry.cost_usd|money }}</dd>
    </div>
    <div>
      <dt>Cost / M items{% if entry.reference_cost_usd is not none %} <span class="dt-sub">at {{ entry.reference_hourly_rate_usd|money }}/h reference rate</span>{% endif %}</dt>
      <dd>{{ entry.cost_per_million_items|money }}</dd>
    </div>
  </dl>
</section>

<section class="scheme-matrix-panel">
  <h2>Accuracy across label schemes</h2>
  <p class="note">The headline accuracy is lexEN v1 · WordNet fine-grained. Each cell re-scores this run's predictions against a different gold label set and sense granularity; coarse counts a prediction correct when its WordNet sense maps to the same Glite or CSI concept as a gold sense. <a href="{{ base_path }}label-schemes/">About these label schemes →</a> <a href="{{ base_path }}coarsening/">About coarsening →</a></p>
  <div class="table-scroll">
    <table class="scheme-matrix">
      <thead>
        <tr>
          <th>Score against</th>
          {% for granularity in scheme_granularities %}<th>{{ granularity.label }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for source in scheme_gold_sources %}
        <tr>
          <th scope="row">{{ source.label }}</th>
          {% for granularity in scheme_granularities %}
          {% set score = entry.scheme_scores.get(source.value ~ "_" ~ granularity.value) %}
          <td>
            {% if score and score.accuracy is not none %}
            <span class="cell-primary">{{ score.accuracy|pct }}</span>
            <span class="cell-secondary">{{ score.correct_count }} / {{ score.item_count }}</span>
            {% else %}n/a{% endif %}
          </td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="detail-grid">
  <div class="detail-block">
    <h2>Model</h2>
    <dl>
      <dt>Display</dt><dd>{{ metadata.model.display_name }}</dd>
      <dt>Requested</dt><dd>{{ entry.requested_model }}</dd>
      <dt>Resolved</dt><dd>{{ entry.resolved_model or "n/a" }}</dd>
      <dt>Vendor</dt><dd>{{ entry.llm_vendor or "n/a" }}</dd>
      <dt>API provider</dt><dd>{{ entry.api_provider or "n/a" }}</dd>
      <dt>Hosting</dt><dd>{{ entry.hosting_kind }}</dd>
      <dt>Source</dt><dd>{{ entry.source_kind }}</dd>
      <dt>License</dt><dd>{{ entry.license or "n/a" }}</dd>
      <dt>Reasoning</dt><dd>{{ entry.reasoning_effort or "n/a" }}</dd>
      <dt>Model URL</dt>
      <dd>{% if entry.model_url %}<a href="{{ entry.model_url }}">{{ entry.model_url }}</a>{% else %}n/a{% endif %}</dd>
      <dt>Endpoint</dt><dd class="hash">{{ metadata.model.endpoint_base_url or "n/a" }}</dd>
      <dt>Resolved counts</dt>
      <dd>
        {% if metadata.model.resolved_model_counts %}
        {% for model_name, count in metadata.model.resolved_model_counts.items() %}
        <span class="kv-chip">{{ model_name }}: {{ count }}</span>
        {% endfor %}
        {% else %}
        n/a
        {% endif %}
      </dd>
      {% if metadata.model.hf_revision is defined %}
      <dt>HF revision</dt><dd>{{ metadata.model.hf_revision or "n/a" }}</dd>
      <dt>Quantization</dt><dd>{{ metadata.model.quantization or "n/a" }}</dd>
      <dt>Inference engine</dt><dd>{{ metadata.model.inference_engine or "n/a" }}</dd>
      <dt>Engine version</dt><dd>{{ metadata.model.inference_engine_version or "n/a" }}</dd>
      <dt>Container image</dt><dd>{{ metadata.model.container_image or "n/a" }}</dd>
      {% if metadata.model.serve_command %}
      <dt>Serve command</dt><dd><code class="serve-command">{{ metadata.model.serve_command }}</code></dd>
      {% endif %}
      {% endif %}
    </dl>
  </div>
  <div class="detail-block">
    <h2>Reproducibility</h2>
    <dl>
      <dt>Created</dt><dd>{{ entry.created_at }}</dd>
      <dt>Run schema</dt><dd>{{ metadata.schema_version }}</dd>
      <dt>Commit</dt><dd class="hash">{{ entry.git_commit or "n/a" }}</dd>
      <dt>Dataset ID</dt><dd>{{ metadata.dataset.dataset_id }}</dd>
      <dt>Dataset version</dt><dd>{{ entry.dataset_version }}</dd>
      <dt>Dataset revision</dt><dd>{{ metadata.dataset.dataset_revision or "n/a" }}</dd>
      <dt>Dataset items</dt><dd>{{ metadata.dataset.item_count|num }}</dd>
      <dt>Dataset hash</dt><dd class="hash">{{ entry.dataset_content_hash }}</dd>
      <dt>Prompt</dt><dd><a href="{{ base_path }}prompts/{{ entry.prompt_id }}/">{{ entry.prompt_id }}</a></dd>
      <dt>Prompt version</dt><dd>{{ metadata.prompt.sensebench_version or "n/a" }}</dd>
      <dt>Repository files</dt><dd><a href="{{ repository_artifact_url }}">Browse in GitHub</a></dd>
    </dl>
  </div>
  <div class="detail-block">
    <h2>Runtime</h2>
    <dl>
      <dt>Calls</dt><dd>{{ entry.call_count }}</dd>
      <dt>Total tokens</dt><dd>{{ entry.total_tokens|num }}</dd>
      <dt>Tokens / item</dt><dd>{{ entry.tokens_per_item|num }}</dd>
      <dt>Total cost</dt><dd>{{ entry.cost_usd|money }}{% if entry.reference_cost_usd is not none %} at {{ metadata.machine.hourly_rate_usd|money }}/h paid{% endif %}</dd>
      {% if entry.reference_cost_usd is not none %}<dt>Total cost at reference rate</dt><dd>{{ entry.reference_cost_usd|money }} at {{ entry.reference_hourly_rate_usd|money }}/h</dd>{% endif %}
      <dt>Cost / M items</dt><dd>{{ entry.cost_per_million_items|money }}</dd>
      <dt>Cost source</dt><dd>{{ entry.cost_source }}</dd>
      <dt>Elapsed</dt><dd>{{ entry.elapsed_seconds|seconds }}</dd>
      <dt>Success items</dt><dd>{{ entry.success_count|num }}</dd>
      <dt>Monosemous</dt><dd>{{ entry.monosemous_count|num }}</dd>
      <dt>No candidates</dt><dd>{{ entry.no_candidates_count|num }}</dd>
      <dt>No valid vote</dt><dd>{{ entry.no_valid_vote_count|num }}</dd>
      <dt>Invalid votes</dt><dd>{{ entry.invalid_output_vote_count }}</dd>
      <dt>Transport errors</dt><dd>{{ entry.transport_error_vote_count }}</dd>
    </dl>
  </div>
  {% if metadata.machine %}
  <div class="detail-block">
    <h2>Machine &amp; Timing</h2>
    <dl>
      {% if metadata.machine.gpu %}
      <dt>GPU</dt><dd>{% if metadata.machine.gpu.count > 1 %}{{ metadata.machine.gpu.count }}×{% endif %}{{ metadata.machine.gpu.name }}</dd>
      <dt>VRAM / GPU</dt><dd>{% if metadata.machine.gpu.vram_mib_per_gpu is not none %}{{ metadata.machine.gpu.vram_mib_per_gpu|num }} MiB{% else %}n/a{% endif %}</dd>
      <dt>Driver</dt><dd>{{ metadata.machine.gpu.driver_version or "n/a" }}</dd>
      <dt>CUDA</dt><dd>{{ metadata.machine.gpu.cuda_version or "n/a" }}</dd>
      {% else %}
      <dt>GPU</dt><dd>n/a</dd>
      {% endif %}
      <dt>CPU</dt><dd>{{ metadata.machine.cpu_model or "n/a" }}{% if metadata.machine.cpu_cores %} ({{ metadata.machine.cpu_cores|num }} cores){% endif %}</dd>
      <dt>RAM</dt><dd>{% if metadata.machine.ram_gib is not none %}{{ metadata.machine.ram_gib|num }} GiB{% else %}n/a{% endif %}</dd>
      <dt>Platform</dt><dd>{{ metadata.machine.platform or "n/a" }}</dd>
      <dt>Provider</dt><dd>{{ metadata.machine.provider or "n/a" }}{% if metadata.machine.instance_id %} ({{ metadata.machine.instance_id }}){% endif %}</dd>
      <dt>Hourly rate paid</dt><dd>{% if metadata.machine.hourly_rate_usd is not none %}{{ metadata.machine.hourly_rate_usd|money }}/h{% else %}n/a{% endif %}</dd>
      <dt>Reference rate</dt><dd>{% if entry.reference_hourly_rate_usd is not none %}{{ entry.reference_hourly_rate_usd|money }}/h{% else %}n/a{% endif %}</dd>
      <dt>Benchmark time</dt><dd>{{ entry.benchmark_seconds|seconds }}</dd>
      <dt>Machine-hours / 1M items</dt><dd>{{ entry.machine_hours_per_million_items|machine_hours }}</dd>
      <dt>Concurrency</dt><dd>{{ entry.concurrency|num }}</dd>
    </dl>
    <p class="note">Benchmark time covers only the per-item evaluation loop on this machine, excluding model and asset loading.</p>
  </div>
  {% endif %}
  <div class="detail-block">
    <h2>Runner</h2>
    <dl>
      <dt>GitHub</dt><dd>{{ metadata.runner.github_handle or "n/a" }}</dd>
      <dt>Name</dt><dd>{{ metadata.runner.name or "n/a" }}</dd>
      <dt>Contact</dt><dd>{{ metadata.runner.contact or "n/a" }}</dd>
    </dl>
  </div>
  <div class="detail-block">
    <h2>Sampling</h2>
    <dl>
      <dt>Temperature</dt><dd>{{ metadata.sampling.temperature|num }}</dd>
      <dt>Top P</dt><dd>{{ metadata.sampling.top_p|num }}</dd>
      <dt>Max tokens</dt><dd>{{ metadata.sampling.max_tokens|num }}</dd>
      <dt>Seed</dt><dd>{{ metadata.sampling.seed|num }}</dd>
      <dt>Extra</dt>
      <dd>
        {% if metadata.sampling.extra %}
        {% for key, value in metadata.sampling.extra.items() %}
        <span class="kv-chip">{{ key }}: {{ value }}</span>
        {% endfor %}
        {% else %}
        n/a
        {% endif %}
      </dd>
    </dl>
  </div>
  <div class="detail-block">
    <h2>Policy</h2>
    <dl>
      <dt>Votes / item</dt><dd>{{ metadata.policy.votes_per_item|num }}</dd>
      <dt>Reasks / invalid vote</dt>
      <dd>{{ metadata.policy.semantic_reasks_per_invalid_vote|num }}</dd>
      <dt>Tie break</dt><dd>{{ metadata.policy.tie_break }}</dd>
      <dt>Monosemous</dt><dd>{{ metadata.policy.monosemous_policy }}</dd>
    </dl>
  </div>
</section>

<section class="cost-panel">
  <h2>Cost And Token Breakdown</h2>
  <p class="note">Actual recorded run cost: {{ entry.cost_usd|money }}. Cost estimate source: {{ entry.cost_source }}.{% if entry.cost_source == "machine_time_estimate" %} Cost is estimated from machine time multiplied by the hourly rate this machine was actually rented at ({{ metadata.machine.hourly_rate_usd|money }}/h).{% if entry.reference_cost_usd is not none %} Rented GPU prices move between rentals, so the leaderboard instead compares this run at the {{ entry.reference_hourly_rate_usd|money }}/h reference rate for {{ entry.gpu }}, giving {{ entry.reference_cost_usd|money }} ({{ entry.cost_per_million_items|money }} / M items).{% endif %}{% endif %}</p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Token Type</th>
          <th>Tokens</th>
          <th>Cost</th>
          <th>Price / 1M tokens</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Input uncached</td>
          <td>{{ entry.input_uncached_tokens|num }}</td>
          <td>{{ entry.input_uncached_usd|money }}</td>
          <td>{{ entry.input_uncached_unit_price_usd|million_token_price }}</td>
        </tr>
        <tr>
          <td>Input cached</td>
          <td>{{ entry.cached_input_tokens|num }}</td>
          <td>{{ entry.input_cached_usd|money }}</td>
          <td>{{ entry.input_cached_unit_price_usd|million_token_price }}</td>
        </tr>
        <tr>
          <td>Output</td>
          <td>{{ entry.output_tokens|num }}</td>
          <td>{{ entry.output_usd|money }}</td>
          <td>{{ entry.output_unit_price_usd|million_token_price }}</td>
        </tr>
        <tr>
          <td>Reasoning output</td>
          <td>{{ entry.reasoning_output_tokens|num }}</td>
          <td>included in output cost</td>
          <td>n/a</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="note">Reasoning output tokens are shown separately when the provider reports them; recorded cost is stored in the output cost bucket.</p>
</section>

<section class="artifact-panel">
  <h2>Download Raw Run Files</h2>
  <div class="artifact-grid">
    {% for artifact in detail.artifacts %}
    <a class="artifact-card" href="{{ base_path }}{{ artifact.path }}" download>
      <span class="artifact-title">{{ artifact.label }}</span>
      <span class="artifact-filename">{{ artifact.filename }}</span>
      <span class="artifact-description">{{ artifact.description }}</span>
      <span class="artifact-size">{{ artifact.size_bytes|bytes }}</span>
    </a>
    {% endfor %}
  </div>
</section>

<section>
  <h2>Slice Breakdown</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Group</th>
          <th>Bucket</th>
          <th>Accuracy</th>
          <th>Correct</th>
          <th>Items</th>
        </tr>
      </thead>
      <tbody>
        {% for summary in detail.slices %}
        <tr>
          <td>{{ summary.group }}</td>
          <td>{{ summary.value or "n/a" }}</td>
          <td>{{ summary.accuracy|pct }}</td>
          <td>{{ summary.correct_count }}</td>
          <td>{{ summary.item_count }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section>
  <h2>Worst-Bucket Examples</h2>
  <div class="example-list">
    {% for example in detail.worst_examples %}
    <article class="example-card">
      <header class="example-header">
        <div>
          <h3>{{ example.lemma }} {{ example.pos|title }}</h3>
          <p class="example-meta">
            Instance: {{ example.item_id }}
            <span>Dataset: {{ example.source_dataset or "n/a" }}</span>
            <span>Bucket: {{ example.bucket_group }} / {{ example.bucket_value or "n/a" }}</span>
          </p>
        </div>
        <div class="example-outcome">
          {% if example.is_correct %}
          <span class="badge badge-correct">Correct</span>
          {% else %}
          <span class="badge badge-wrong">Incorrect</span>
          {% endif %}
        </div>
      </header>

      <div class="context-block">
        {% for sentence in example.context_sentences %}
        <p class="{% if sentence.is_target_sentence %}target-context{% endif %}">
          {{ sentence.html|safe }}
        </p>
        {% endfor %}
      </div>

      {% if example.prompt_messages %}
      <details class="raw-prompt">
        <summary>Show raw prompt</summary>
        <div class="prompt-message-list">
          {% for message in example.prompt_messages %}
          <section class="prompt-message">
            <p class="prompt-role">{{ message.role.value }}</p>
            <pre class="prompt-content">{{ message.content }}</pre>
          </section>
          {% endfor %}
        </div>
      </details>
      {% endif %}

      <p class="predicted-matches">
        <span class="pm-label">Prediction matches gold:</span>
        {% for key, name in [("lexen", "lexEN"), ("maru2022", "Maru 2022"), ("raganato", "Raganato")] %}
        {% set m = example.predicted_matches_fine.get(key) %}
        <span class="match-chip {{ 'match-yes' if m == true else ('match-no' if m == false else 'match-na') }}">{{ name }} {{ '✓' if m == true else ('✗' if m == false else '—') }}</span>
        {% endfor %}
      </p>

      <h4>WordNet 3.0 senses</h4>
      <ol class="sense-list">
        {% for candidate in example.candidates %}
        <li class="sense-row{% if candidate.is_gold %} is-gold{% endif %}{% if candidate.is_selected %} is-selected{% endif %}">
          <div class="sense-main">
            <span class="sense-index">{{ candidate.index }}</span>
            <div>
              <p class="sense-definition">{{ candidate.definition or "Definition unavailable" }}</p>
              <p class="sense-key">{{ candidate.sense_key }} · {{ candidate.synset_id }}</p>
              {% if candidate.examples %}
              <ul class="sense-examples">
                {% for usage in candidate.examples[:2] %}
                <li>{{ usage }}</li>
                {% endfor %}
              </ul>
              {% endif %}
              {% if candidate.synonyms %}
              <p class="sense-synonyms">Synonyms: {{ candidate.synonyms|join(", ") }}</p>
              {% endif %}
            </div>
          </div>
          <div class="sense-badges">
            {% if candidate.is_gold %}<span class="badge badge-gold">Gold lexEN</span>{% endif %}
            {% if candidate.is_gold_maru2022 %}<span class="badge badge-gold-alt">Gold Maru 2022</span>{% endif %}
            {% if candidate.is_gold_raganato %}<span class="badge badge-gold-alt">Gold Raganato</span>{% endif %}
            {% if candidate.is_selected %}<span class="badge badge-selected">Selected</span>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
    </article>
    {% endfor %}
  </div>
</section>
{% endblock %}
