{% extends "base.html.j2" %}

{% block content %}
{% set entry = detail.entry %}
<section class="run-head">
  <div>
    <p class="eyebrow">Verified run</p>
    <h1>{{ entry.model }}</h1>
    <p class="run-id">{{ entry.run_id }}</p>
  </div>
  <dl class="summary-grid">
    <div>
      <dt>Rank</dt>
      <dd>{{ entry.rank }}</dd>
    </div>
    <div>
      <dt>Accuracy</dt>
      <dd>{{ entry.accuracy|pct }}</dd>
    </div>
    <div>
      <dt>Correct</dt>
      <dd>{{ entry.correct_count }} / {{ entry.item_count }}</dd>
    </div>
    <div>
      <dt>Cost / M items</dt>
      <dd>{{ entry.cost_per_million_items|money }}</dd>
    </div>
  </dl>
</section>

<section class="detail-grid">
  <div class="detail-block">
    <h2>Model</h2>
    <dl>
      <dt>Requested</dt><dd>{{ entry.requested_model }}</dd>
      <dt>Resolved</dt><dd>{{ entry.resolved_model or "n/a" }}</dd>
      <dt>Vendor</dt><dd>{{ entry.llm_vendor or "n/a" }}</dd>
      <dt>Hosting</dt><dd>{{ entry.hosting_kind }}</dd>
      <dt>Source</dt><dd>{{ entry.source_kind }}</dd>
      <dt>License</dt><dd>{{ entry.license or "n/a" }}</dd>
    </dl>
  </div>
  <div class="detail-block">
    <h2>Reproducibility</h2>
    <dl>
      <dt>Dataset</dt><dd>{{ entry.dataset_version }}</dd>
      <dt>Dataset hash</dt><dd class="hash">{{ entry.dataset_content_hash }}</dd>
      <dt>Prompt</dt><dd>{{ entry.prompt_id }}</dd>
      <dt>Commit</dt><dd class="hash">{{ entry.git_commit or "n/a" }}</dd>
      <dt>Artifacts</dt><dd><a href="{{ artifact_url }}">{{ artifact_path }}</a></dd>
    </dl>
  </div>
  <div class="detail-block">
    <h2>Runtime</h2>
    <dl>
      <dt>Calls</dt><dd>{{ entry.call_count }}</dd>
      <dt>Total tokens</dt><dd>{{ entry.total_tokens|num }}</dd>
      <dt>Tokens / item</dt><dd>{{ entry.tokens_per_item|num }}</dd>
      <dt>Total cost</dt><dd>{{ entry.cost_usd|money }}</dd>
      <dt>Cost / M items</dt><dd>{{ entry.cost_per_million_items|money }}</dd>
      <dt>Cost source</dt><dd>{{ entry.cost_source }}</dd>
      <dt>Invalid votes</dt><dd>{{ entry.invalid_output_vote_count }}</dd>
      <dt>Transport errors</dt><dd>{{ entry.transport_error_vote_count }}</dd>
    </dl>
  </div>
</section>

<section class="cost-panel">
  <h2>Cost And Token Breakdown</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Token Type</th>
          <th>Tokens</th>
          <th>Cost</th>
          <th>Price / token</th>
          <th>Price / M tokens</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Input uncached</td>
          <td>{{ entry.input_uncached_tokens|num }}</td>
          <td>{{ entry.input_uncached_usd|money }}</td>
          <td>{{ entry.input_uncached_unit_price_usd|token_price }}</td>
          <td>{{ entry.input_uncached_unit_price_usd|million_token_price }}</td>
        </tr>
        <tr>
          <td>Input cached</td>
          <td>{{ entry.cached_input_tokens|num }}</td>
          <td>{{ entry.input_cached_usd|money }}</td>
          <td>{{ entry.input_cached_unit_price_usd|token_price }}</td>
          <td>{{ entry.input_cached_unit_price_usd|million_token_price }}</td>
        </tr>
        <tr>
          <td>Output</td>
          <td>{{ entry.output_tokens|num }}</td>
          <td>{{ entry.output_usd|money }}</td>
          <td>{{ entry.output_unit_price_usd|token_price }}</td>
          <td>{{ entry.output_unit_price_usd|million_token_price }}</td>
        </tr>
        <tr>
          <td>Reasoning output</td>
          <td>{{ entry.reasoning_output_tokens|num }}</td>
          <td>included in output cost</td>
          <td>n/a</td>
          <td>n/a</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="note">Reasoning output tokens are shown separately when the provider reports them; recorded cost is stored in the output cost bucket.</p>
</section>

<section>
  <h2>Slice Breakdown</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Group</th>
          <th>Bucket</th>
          <th>Accuracy</th>
          <th>Correct</th>
          <th>Items</th>
        </tr>
      </thead>
      <tbody>
        {% for summary in detail.slices %}
        <tr>
          <td>{{ summary.group }}</td>
          <td>{{ summary.value }}</td>
          <td>{{ summary.accuracy|pct }}</td>
          <td>{{ summary.correct_count }}</td>
          <td>{{ summary.item_count }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section>
  <h2>Worst-Bucket Examples</h2>
  <div class="example-list">
    {% for example in detail.worst_examples %}
    <article class="example-card">
      <header class="example-header">
        <div>
          <h3>{{ example.lemma }} {{ example.pos|title }}</h3>
          <p class="example-meta">
            Instance: {{ example.item_id }}
            <span>Dataset: {{ example.source_dataset }}</span>
            <span>Bucket: {{ example.bucket_group }} / {{ example.bucket_value }}</span>
          </p>
        </div>
        <div class="example-outcome">
          {% if example.is_correct %}
          <span class="badge badge-correct">Correct</span>
          {% else %}
          <span class="badge badge-wrong">Incorrect</span>
          {% endif %}
        </div>
      </header>

      <div class="context-block">
        {% for sentence in example.context_sentences %}
        <p class="{% if sentence.is_target_sentence %}target-context{% endif %}">
          {{ sentence.html|safe }}
        </p>
        {% endfor %}
      </div>

      <h4>WordNet 3.0 senses</h4>
      <ol class="sense-list">
        {% for candidate in example.candidates %}
        <li class="sense-row{% if candidate.is_gold %} is-gold{% endif %}{% if candidate.is_selected %} is-selected{% endif %}">
          <div class="sense-main">
            <span class="sense-index">{{ candidate.index }}</span>
            <div>
              <p class="sense-definition">{{ candidate.definition or "Definition unavailable" }}</p>
              <p class="sense-key">{{ candidate.sense_key }} · {{ candidate.synset_id }}</p>
              {% if candidate.examples %}
              <ul class="sense-examples">
                {% for usage in candidate.examples[:2] %}
                <li>{{ usage }}</li>
                {% endfor %}
              </ul>
              {% endif %}
              {% if candidate.synonyms %}
              <p class="sense-synonyms">Synonyms: {{ candidate.synonyms|join(", ") }}</p>
              {% endif %}
            </div>
          </div>
          <div class="sense-badges">
            {% if candidate.is_gold %}<span class="badge badge-gold">Gold</span>{% endif %}
            {% if candidate.is_selected %}<span class="badge badge-selected">Selected</span>{% endif %}
          </div>
        </li>
        {% endfor %}
      </ol>
    </article>
    {% endfor %}
  </div>
</section>
{% endblock %}
