{% extends "base.html.j2" %}

{% block content %}
<section class="page-title">
  <p class="eyebrow">{{ page.slug }}</p>
  <h1>{{ page.title }}</h1>
  <p>{{ page.description }}</p>
</section>

{% for section in page.sections %}
<section class="doc-section">
  <h2>{{ section.title }}</h2>
  {% for paragraph in section.paragraphs %}
  <p>{{ paragraph }}</p>
  {% endfor %}
</section>
{% endfor %}
{% endblock %}
