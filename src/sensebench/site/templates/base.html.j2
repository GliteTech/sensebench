<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:image" content="{{ og_image_url }}?v={{ asset_version }}">
    <meta property="og:image:width" content="{{ og_image_width }}">
    <meta property="og:image:height" content="{{ og_image_height }}">
    <meta property="og:image:alt" content="{{ og_image_alt }}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" type="image/svg+xml" href="{{ base_path }}assets/favicon.svg?v={{ asset_version }}">
    <link rel="stylesheet" href="{{ base_path }}assets/site.css?v={{ asset_version }}">
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="{{ base_path }}">
        {% include "glite_logo.svg.j2" %}
        <span>SenseBench</span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="{{ base_path }}">Leaderboard</a>
        <a href="{{ base_path }}runs/">Runs</a>
        <a href="https://github.com/GliteTech/lexen" rel="noopener">Dataset</a>
        <a href="{{ base_path }}prompts/">Prompts</a>
        <a href="{{ base_path }}label-schemes/">Label schemes</a>
        <a href="{{ base_path }}coarsening/">Coarsening</a>
        <a href="{{ base_path }}methodology/">Methodology</a>
        <a href="{{ base_path }}submit/">Submit</a>
      </nav>
      <button class="theme-toggle" id="theme-toggle" type="button">Theme</button>
    </header>
    <main id="content" class="page-shell">
      {% block content %}{% endblock %}
    </main>
    <footer class="site-footer">
      <span>SenseBench</span>
      <a href="{{ base_path }}about/">About</a>
      <a href="{{ base_path }}changelog/">Changelog</a>
      <a href="{{ base_path }}citation/">Citation</a>
      <a href="https://glite.ai/" rel="noopener">Built by Glite</a>
    </footer>
    <script>
      window.SENSEBENCH_BASE_PATH = "{{ base_path }}";
      window.SENSEBENCH_DATA_VERSION = "{{ asset_version }}";
    </script>
    <script src="{{ base_path }}assets/theme.js?v={{ asset_version }}"></script>
    {% block scripts %}{% endblock %}
  </body>
</html>
